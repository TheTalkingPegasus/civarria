{
  "name": "civarria",
  "productName": "Civarria",
  "version": "0.1.0",
  "description": "Civarria – Zivilisationen beobachten wie in einem Terrarium",
  "author": "TheTalkingPegasus",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "python src/build.py",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.thetalkingpegasus.civarria",
    "productName": "Civarria",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Civarria",
      "artifactName": "Civarria-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "TheTalkingPegasus",
        "repo": "civarria",
        "releaseType": "release"
      }
    ]
  },
  "homepage": "https://github.com/TheTalkingPegasus/civarria"
}
